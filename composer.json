{
    "name": "noviasnet/laravel-yousign",
    "description": "A simple laravel wrapper for Yousign API v3",
    "keywords": [
        "NoviasNet",
        "laravel",
        "laravel-yousign"
    ],
    "homepage": "https://github.com/NoviasNet/laravel-yousign",
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriele Sbaiz",
            "email": "gabriele.sbaiz@noviasnet.it",
            "role": "Developer"
        },
        {
            "name": "Gabriele Pistoia",
            "email": "gabriele.pistoia@noviasnet.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.12.0",
        "spatie/laravel-webhook-client": "^3.0",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0",
        "psr/simple-cache": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^1.2",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^6.0",
        "nunomaduro/larastan": "^2.0.1",
        "orchestra/testbench": "^7.0",
        "pestphp/pest": "^1.21",
        "pestphp/pest-plugin-laravel": "^1.1",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^1.2",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "NoviasNet\\Yousign\\": "src",
            "NoviasNet\\Yousign\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NoviasNet\\Yousign\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NoviasNet\\Yousign\\YousignServiceProvider"
            ],
            "aliases": {
                "Yousign": "NoviasNet\\Yousign\\Facades\\Yousign"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
